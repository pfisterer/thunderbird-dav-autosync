{
  "extensionName": {
    "message": "DAV Autosync"
  },
  "extensionDescription": {
    "message": "Keeps CalDAV calendars and CardDAV address books in step with the server: new ones appear, removed ones disappear."
  },
  "kindCalendar": {
    "message": "Calendar"
  },
  "kindAddressBook": {
    "message": "Address book"
  },
  "warnListingUnavailable": {
    "message": "$KIND$: the list from the server is not available, nothing changed.",
    "placeholders": {
      "kind": {
        "content": "$1"
      }
    }
  },
  "warnServerEmpty": {
    "message": "$KIND$: the server reports no entries; the $COUNT$ managed ones are kept as a precaution.",
    "placeholders": {
      "kind": {
        "content": "$1"
      },
      "count": {
        "content": "$2"
      }
    }
  },
  "warnRemovalDeferred": {
    "message": "$KIND$ “$NAME$” is missing on the server ($COUNT$/$LIMIT$), not removed yet.",
    "placeholders": {
      "kind": {
        "content": "$1"
      },
      "name": {
        "content": "$2"
      },
      "count": {
        "content": "$3"
      },
      "limit": {
        "content": "$4"
      }
    }
  },
  "davNetwork": {
    "message": "Server unreachable: $DETAIL$",
    "placeholders": {
      "detail": {
        "content": "$1"
      }
    }
  },
  "davAuth": {
    "message": "Login rejected (HTTP $STATUS$)",
    "placeholders": {
      "status": {
        "content": "$1"
      }
    }
  },
  "davStatus": {
    "message": "Unexpected answer from the server (HTTP $STATUS$)",
    "placeholders": {
      "status": {
        "content": "$1"
      }
    }
